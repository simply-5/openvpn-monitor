[openvpn-monitor]
site=Example
#logo=logo.jpg
#latitude=40.72
#longitude=-74
maps=True
geoip_data=/var/lib/GeoIP/GeoLite2-City.mmdb
datetime_format=%d/%m/%Y %H:%M:%S
# Passed to the ssh of the client detail page.
# ssh expands ~ against the home in the passwd database and ignores $HOME,
# so leave these unset wherever that lookup lands on the credentials.
# Name them where it cannot be made to:
# a systemd DynamicUser= account has no home of its own,
# its passwd entry reads /,
# and nothing - HOME= included - can point ssh elsewhere.
#ssh_identity_file=/var/lib/openvpn-monitor/id_ed25519
#ssh_known_hosts_file=/var/lib/openvpn-monitor/known_hosts

[VPN1]
host=localhost
port=5555
name=Staff VPN
show_disconnect=False
