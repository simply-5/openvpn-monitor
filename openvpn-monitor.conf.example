[openvpn-monitor]
site=Example
#logo=logo.jpg
#latitude=40.72
#longitude=-74
maps=True
geoip_data=/var/lib/GeoIP/GeoLite2-City.mmdb
datetime_format=%d/%m/%Y %H:%M:%S
# Passed to the ssh of the client detail page.
# Leave unset to let ssh use its own defaults, which it resolves against
# the account's passwd home - name them when the service runs as a user
# whose home is not where the credentials are.
#ssh_identity_file=/var/lib/openvpn-monitor/id_ed25519
#ssh_known_hosts_file=/var/lib/openvpn-monitor/known_hosts

[VPN1]
host=localhost
port=5555
name=Staff VPN
show_disconnect=False
